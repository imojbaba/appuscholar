 "v1": {
  "build": "2026.10.13a",
  "sha256": "e3ad7404efcc2684144cc86a8d9bc8cd607e98b3580283c769fe00e18b5fcb47",
  "lines": 13699
 },
 "rules": [
  {
   "id": "discuss-about",
   "kind": "error",
   "rule": "“Discuss” takes its object directly",
   "why": "Say “discuss the results”, not “discuss about the results”.",
   "ex": [
    "We discussed about the results.",
    "We discussed the results."
   ],
   "source": "\\b(discuss(?:es|ed|ing)?)\\s+about\\b",
   "flags": "gi"
  },
  {
   "id": "return-back",
   "kind": "style",
   "rule": "“Return” already means “come back”",
   "why": "“Return back” says “back” twice.",
   "ex": [
    "She returned back to the lab.",
    "She returned to the lab."
   ],
   "source": "\\b(return(?:s|ed|ing)?)\\s+back\\b",
   "flags": "gi"
  },
  {
   "id": "revert-back",
   "kind": "style",
   "rule": "“Revert” already means “go back”",
   "why": "“Revert back” says “back” twice. In India it often means “reply”; in formal writing say “reply” or “revert”.",
   "ex": [
    "Please revert back soon.",
    "Please reply soon."
   ],
   "source": "\\brevert(?:s|ed|ing)?\\s+back\\b",
   "flags": "gi"
  },
  {
   "id": "uncountable",
   "kind": "error",
   "rule": "Some nouns have no plural",
   "why": "Words such as information, equipment, advice and feedback are not used in the plural.",
   "ex": [
    "The informations were useful.",
    "The information was useful."
   ],
   "source": "\\b(informations|equipments|advices|furnitures|luggages|baggages|feedbacks|knowledges|evidences|staffs|stationeries)\\b",
   "flags": "gi"
  },
  {
   "id": "cope-up",
   "kind": "error",
   "rule": "“Cope” takes “with”",
   "why": "Say “cope with stress”, not “cope up with stress”.",
   "ex": [
    "He could not cope up with stress.",
    "He could not cope with stress."
   ],
   "source": "\\b(cop(?:e|es|ed|ing))\\s+up\\s+with\\b",
   "flags": "gi"
  },
  {
   "id": "stative-progressive",
   "kind": "error",
   "rule": "Some verbs are not used in the continuous form",
   "why": "Verbs of state such as know, understand, want, like, believe, need and own take the simple form: “I know”, not “I am knowing”.",
   "ex": [
    "I am knowing the answer.",
    "I know the answer."
   ],
   "source": "\\b(am|is|are|was|were)\\s+(knowing|understanding|wanting|liking|believing|needing|owning|hating)\\b",
   "flags": "gi"
  },
  {
   "id": "more-better",
   "kind": "error",
   "rule": "Do not add “more” or “most” to a comparative",
   "why": "“Better” and “easier” are already comparatives.",
   "ex": [
    "This is more better.",
    "This is better."
   ],
   "source": "\\b(more|most)\\s+(better|easier|faster|worse|bigger|smaller|higher|lower|larger|taller|best|worst|simpler|cheaper)\\b",
   "flags": "gi"
  },
  {
   "id": "since-period",
   "kind": "error",
   "rule": "“Since” goes with a point in time, “for” with a length of time",
   "why": "Say “for two years”, not “since two years”.",
   "ex": [
    "I have studied since two years.",
    "I have studied for two years."
   ],
   "source": "\\bsince\\s+((?:\\d+|two|three|four|five|six|seven|eight|nine|ten|several|many|few|a few)\\s+(?:years|months|weeks|days|hours))\\b",
   "flags": "gi"
  },
  {
   "id": "can-able",
   "kind": "error",
   "rule": "Do not put “able to” straight after “can” or “could”",
   "why": "“Can” already means “is able to”. Say “can” or “will be able to”.",
   "ex": [
    "She can able to finish.",
    "She can finish."
   ],
   "source": "\\b(can|could)\\s+able\\s+to\\b",
   "flags": "gi"
  },
  {
   "id": "will-able",
   "kind": "error",
   "rule": "“Be” is missing before “able to”",
   "why": "Say “will be able to”.",
   "ex": [
    "We will able to start.",
    "We will be able to start."
   ],
   "source": "\\b(will|would|shall|should|may|might|must)\\s+able\\s+to\\b",
   "flags": "gi"
  },
  {
   "id": "its-apostrophe",
   "kind": "error",
   "rule": "“Its” (belonging to it) has no apostrophe",
   "why": "“It’s” means “it is” or “it has”. “Its” shows possession.",
   "ex": [
    "The study and its' limits.",
    "The study and its limits."
   ],
   "source": "\\bits['’](?=\\s)",
   "flags": "gi"
  },
  {
   "id": "modal-of",
   "kind": "error",
   "rule": "“Should of” should be “should have”",
   "why": "The spoken “should’ve” sounds like “should of”, but the written form is “should have”.",
   "ex": [
    "It should of worked.",
    "It should have worked."
   ],
   "source": "\\b(should|could|would|might|must)\\s+of\\b",
   "flags": "gi"
  },
  {
   "id": "run-together",
   "kind": "error",
   "rule": "These are two words (or are spelt differently)",
   "why": "Write “a lot”, “even though”, “in fact”, “at least”, “in spite of”, “as well”.",
   "ex": [
    "It helped alot.",
    "It helped a lot."
   ],
   "source": "\\b(alot|eventhough|infact|atleast|inspite of|aswell)\\b",
   "flags": "gi"
  },
  {
   "id": "agree-he-dont",
   "kind": "error",
   "rule": "Subject and verb must agree",
   "why": "With he, she and it, use “doesn’t”. With I, you, we and they, use “don’t”.",
   "ex": [
    "She don’t agree.",
    "She doesn’t agree."
   ],
   "source": "\\b(he|she|it)\\s+don['’]t\\b",
   "flags": "gi"
  },
  {
   "id": "agree-they-doesnt",
   "kind": "error",
   "rule": "Subject and verb must agree",
   "why": "With I, you, we and they, use “don’t”.",
   "ex": [
    "They doesn’t agree.",
    "They don’t agree."
   ],
   "source": "\\b(i|you|we|they)\\s+doesn['’]t\\b",
   "flags": "gi"
  },
  {
   "id": "there-is-plural",
   "kind": "error",
   "rule": "Use “there are” with a plural",
   "why": "“There is many” should be “there are many”.",
   "ex": [
    "There is many reasons.",
    "There are many reasons."
   ],
   "source": "\\bthere\\s+is\\s+(many|several|few|numerous|two|three|four|five|six)\\b",
   "flags": "gi"
  },
  {
   "id": "article-a",
   "kind": "error",
   "rule": "Use “an” before a vowel sound",
   "why": "Say “an apple”, “an hour”; “a” before a consonant sound.",
   "ex": [
    "a important result",
    "an important result"
   ],
   "source": "\\b(a)\\s+([aeiouAEIOU][\\p{L}-]*)",
   "flags": "gu"
  },
  {
   "id": "article-an",
   "kind": "error",
   "rule": "Use “a” before a consonant sound",
   "why": "Say “a study”, not “an study”. Exceptions are words like “hour” and “honest”.",
   "ex": [
    "an study",
    "a study"
   ],
   "source": "\\b(an)\\s+([bcdfgjklmnpqrstvwxzBCDFGJKLMNPQRSTVWXZ][\\p{L}-]*)",
   "flags": "gu"
  },
  {
   "id": "doubled-word",
   "kind": "style",
   "rule": "A word is repeated",
   "why": "The same word appears twice in a row.",
   "ex": [
    "the the results",
    "the results"
   ],
   "source": "\\b([A-Za-z]+)[ \\t]+\\1\\b",
   "flags": "gi"
  },
  {
   "id": "space-before-punct",
   "kind": "style",
   "rule": "No space before punctuation",
   "why": "A comma, full stop, colon or semicolon follows the word directly.",
   "ex": [
    "results , which",
    "results, which"
   ],
   "source": "(\\S)[ \\t]+([,.;:!?])(?=\\s|$)",
   "flags": "g"
  },
  {
   "id": "space-after-comma",
   "kind": "style",
   "rule": "A space follows a comma",
   "why": "Put a space after a comma before the next word.",
   "ex": [
    "results,which",
    "results, which"
   ],
   "source": "([A-Za-z]),(?=[A-Za-z])",
   "flags": "g"
  },
  {
   "id": "prepone",
   "kind": "regional",
   "rule": "“Prepone” is Indian English",
   "why": "It is understood in India but not in standard English. Say “bring forward” or “move earlier”.",
   "ex": [
    "We preponed the test.",
    "We brought the test forward."
   ],
   "source": "\\bprepon(?:e|es|ed|ing)\\b",
   "flags": "gi"
  },
  {
   "id": "do-needful",
   "kind": "regional",
   "rule": "“Do the needful” is Indian English",
   "why": "It is understood in India and sounds odd in an academic paper. Say what needs to be done.",
   "ex": [
    "Please do the needful.",
    "Please send the form."
   ],
   "source": "\\bdo(?:es|ing)?\\s+the\\s+needful\\b",
   "flags": "gi"
  },
  {
   "id": "enjoy-to",
   "kind": "error",
   "rule": "“Enjoy” is followed by -ing",
   "why": "Say “enjoy reading”, not “enjoy to read”.",
   "ex": [
    "I enjoy to read.",
    "I enjoy reading."
   ],
   "source": "\\benjoy(?:s|ed)?\\s+to\\s+[a-z]+\\b",
   "flags": "gi"
  }
 ],
