# Copy to apps/web/.env.local and apps/api/.env (or export in your shell). Never commit real values.

# --- shared by apps/web and apps/api ---
# Same value in both apps: web signs short-lived api tokens with it, api verifies them.
API_JWT_SECRET=change-me-32-bytes-base64
# Neon (*.neon.tech) uses the serverless HTTP driver; any other host (local, CI) uses node-postgres.
# Required in production (Vercel or NODE_ENV=production): the api refuses to start without it.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- apps/web ---
AUTH_SECRET=change-me-32-bytes-base64
# Trust the X-Forwarded-Host header (needed behind proxies and on non-Vercel hosts).
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=Appuscholar <login@example.com>
NEXT_PUBLIC_API_URL=http://localhost:8788
# Where the Help dialog's "Email us" button writes to (a mailto: link; the app never sends mail). Unset: Help says no contact is set up.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- apps/api ---
# The web app's origin, for CORS. Required in production.
WEB_ORIGIN=http://localhost:3000
PORT=8788

# --- e2e only (never set in production) ---
E2E_AUTH=0
